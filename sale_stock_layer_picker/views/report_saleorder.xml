<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_merged" inherit_id="sale.report_saleorder_document">
        <xpath expr="//tbody[@class='sale_tbody']" position="replace">
            <tbody class="sale_tbody">
                <t t-foreach="doc.get_merged_lines_for_print()" t-as="line">
                    <tr>
                        <td name="td_name"><span t-esc="line['name']"/></td>
                        <td name="td_quantity" class="text-end">
                            <span t-esc="line['product_uom_qty']"/>
                            <span t-esc="line['product_uom'].name"/>
                        </td>
                        <td name="td_priceunit" class="text-end">
                            <span t-esc="line['price_unit']" t-options='{"widget": "monetary", "display_currency": line["currency_id"]}'/>
                        </td>
                        <td t-if="line['discount']" class="text-end">
                            <span t-esc="line['discount']"/>
                        </td>
                        <td name="td_taxes" class="text-end">
                            <span t-esc="', '.join(map(str, line['tax_id'].mapped('name')))"/>
                        </td>
                        <td name="td_subtotal" class="text-end o_price_total">
                            <span t-esc="line['price_subtotal']" t-options='{"widget": "monetary", "display_currency": line["currency_id"]}'/>
                        </td>
                    </tr>
                </t>
            </tbody>
        </xpath>
    </template>
</odoo>