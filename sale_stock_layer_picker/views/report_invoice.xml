<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_inherit_merge" inherit_id="account.report_invoice_document">
        <xpath expr="//tbody[@class='invoice_tbody']" position="replace">
            <tbody class="invoice_tbody">
                <t t-foreach="o.get_merged_invoice_lines_for_print()" t-as="line">
                    <tr>
                        <td name="account_invoice_line_name"><span t-esc="line['name']"/></td>
                        <td class="text-end">
                            <span t-esc="line['quantity']"/>
                            <span t-esc="line['product_uom_id'].name"/>
                        </td>
                        <td class="text-end">
                            <span t-esc="line['price_unit']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                        <td t-if="display_discount" class="text-end">
                            <span t-esc="line['discount']"/>
                        </td>
                        <td class="text-end">
                            <span t-esc="', '.join(map(str, line['tax_ids'].mapped('name')))"/>
                        </td>
                        <td class="text-end o_price_total">
                            <span t-esc="line['price_subtotal']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                    </tr>
                </t>
            </tbody>
        </xpath>
    </template>
</odoo>