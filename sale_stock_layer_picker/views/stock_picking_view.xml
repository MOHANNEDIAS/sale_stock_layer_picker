<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_target_layer" model="ir.ui.view">
        <field name="name">stock.picking.form.target.layer</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='move_ids_without_package']/list//field[@name='product_id']" position="after">
                
                <field name="target_layer_id" 
                       optional="show" 
                       readonly="1"
                       force_save="1"/>
                
                <field name="unit_cost" 
                       string="Target Cost"
                       optional="show"
                       readonly="1"/>
                       
            </xpath>

        </field>
    </record>
</odoo>