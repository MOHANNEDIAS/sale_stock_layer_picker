<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sales_confirm_warning_wizard_form" model="ir.ui.view">
        <field name="name">sales.confirm.warning.wizard.form</field>
        <field name="model">sales.confirm.warning.wizard</field>
        <field name="arch" type="xml">
            <form string="نسيت شي؟">
                <div class="o_row">
                    <span class="fa fa-smile-o fa-3x text-warning" style="margin-right: 15px;"/>
                    <field name="message" nolabel="1" style="font-size: 16px; font-weight: bold;"/>
                </div>
                <footer>
                    <button string="نعم، أنا بايعها (تأكيد بدون تحديد)" 
                            name="action_confirm_anyway" 
                            type="object" 
                            class="btn-danger"/>
                    <button string="لا، خليني أختار (إلغاء)" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>